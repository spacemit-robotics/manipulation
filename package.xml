<?xml version="1.0"?>
<package format="3">
  <name>manipulation</name>
  <version>0.2.0</version>
  <description>C++ arm/effector contracts, registered drivers, finite tasks and optional calibration tools</description>
  <maintainer email="robot_team@spacemit.com">robot_team</maintainer>
  <license>Apache-2.0</license>
  <depend>pyagxarm</depend>
  <depend>motor</depend>
  <system_depend check="pkg-config --exists yaml-cpp">libyaml-cpp-dev</system_depend>
  <system_depend check="python3 -c 'import numpy'">python3-numpy</system_depend>
  <export><build_type>cmake</build_type></export>
</package>
